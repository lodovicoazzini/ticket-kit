{
  "manifest_version": 3,
  "name": "Ticket Kit",
  "version": "1.4.0",
  "description": "Copy Jira tickets to the clipboard as links, copy branch names and search results, and open tickets and pull requests.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/lodovicoazzini/ticket-kit",
  "permissions": ["activeTab", "scripting", "contextMenus", "offscreen", "clipboardWrite", "storage"],
  "host_permissions": ["https://*.atlassian.net/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ticket Kit: click to copy the Jira link",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "open-menu": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Open the Jira action menu"
    },
    "copy-link": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Copy the open Jira ticket as a link"
    },
    "copy-branch": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Copy a branch name for the open ticket"
    },
    "open-pr": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open the ticket's pull request"
    },
    "copy-list": {
      "description": "Copy the search results as a list"
    }
  },
  "omnibox": { "keyword": "j" },
  "web_accessible_resources": [
    {
      "resources": ["menu.html"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
